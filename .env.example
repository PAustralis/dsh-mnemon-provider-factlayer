# factlayer 环境变量模板 —— 复制为 .env 后填写，.env 不入库
# 仓库与示例中只使用文档专用地址（RFC 5737 / RFC 2606），严禁填入真实地址或密钥

# 事实层 SQLite 单文件路径
DSH_FACT_DB_PATH=/var/lib/factlayer/facts.db

# FalkorDB（Redis 协议）地址
DSH_FALKORDB_URL=redis://192.0.2.10:6379

# embedding 服务
DSH_EMBEDDING_API_URL=
DSH_EMBEDDING_API_KEY=

# FastAPI 服务端口
DSH_SERVER_PORT=8000

# 备份保留份数（backups/ 下最近 N 份，默认 7）
DSH_BACKUP_KEEP=7

# 自动备份检查间隔（秒，默认 86400 = 24h；0 = 关闭自动备份，仍可手动 POST /admin/backup）
DSH_BACKUP_INTERVAL_SECONDS=86400

# 是否启动后台派生循环线程（默认 0；也可手动 POST /derive/tick）
DSH_DERIVE_LOOP_ENABLED=0

# 派生 stub 是否直接视为成功（默认 1；置 0 用于验证失败计数路径）
DSH_DERIVE_STUB_SUCCESS=1

# ---- 检索层 v8 -------------------------------------------------------------
# 出厂唯一开启 bigram（与基线同构的单混合列）；R1 向量默认关
RETRIEVAL_ROUTES=bigram
# 契约：strict-v1 默认 maxRankedResults=4；单条 1200 / 总 4800 字符
FINAL_K=4
ITEM_MAX_CHARS=1200
TOTAL_MAX_CHARS=4800
# 会话展开默认关（开启时只占 FINAL_K 名额内）
EXPAND_ENABLED=0
EXPAND_WINDOW=1
# R1 向量（启用 vector 路线时 EMBEDDING_MODEL 必填）
EMBEDDING_BACKEND=openai-compat
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=auto
EMBEDDING_TIMEOUT_SECONDS=3
EMBEDDING_MAX_SPEND_USD=0.50
# admin 端点：空则只接受回环；非空则要求 X-Admin-Token / Bearer
ADMIN_TOKEN=
# 金丝雀（v8 §9.12）
CANARY_ENABLED=1
CANARY_SIZE=20
CANARY_ALERT_RATE=0.20

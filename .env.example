# factlayer 环境变量模板 —— 复制为 .env 后填写，.env 不入库
# 仓库与示例中只使用文档专用地址（RFC 5737 / RFC 2606），严禁填入真实地址或密钥

# 事实层 SQLite 单文件路径
DSH_FACT_DB_PATH=/var/lib/factlayer/facts.db

# FalkorDB（Redis 协议）地址
DSH_FALKORDB_URL=redis://192.0.2.10:6379

# embedding 服务
DSH_EMBEDDING_API_URL=
DSH_EMBEDDING_API_KEY=

# FastAPI 服务端口
DSH_SERVER_PORT=8000

# 备份保留份数（backups/ 下最近 N 份，默认 7）
DSH_BACKUP_KEEP=7

# 自动备份检查间隔（秒，默认 86400 = 24h；0 = 关闭自动备份，仍可手动 POST /admin/backup）
DSH_BACKUP_INTERVAL_SECONDS=86400

# ---- SQLite 运维 ----------------------------------------------------------
# 每个连接显式设置的 PRAGMA wal_autocheckpoint（页，默认 1000；0 = 关闭自动检查点）
DSH_WAL_AUTOCHECKPOINT_PAGES=1000
# 后台维护在「距上次写入超过 N 秒」后执行 TRUNCATE 检查点的最小间隔（默认 300；0 = 关闭）
DSH_WAL_CHECKPOINT_INTERVAL_SECONDS=300
# 「无写入空闲」阈值（秒，默认 60）。判定是进程本地的：重启后内存时间戳清零，
# 视为「从未写入」（即已空闲），不会沿用库文件/墙钟上的历史写入时间。
DSH_WAL_CHECKPOINT_IDLE_SECONDS=60
# 后台 FTS5 optimize 间隔（秒，默认 86400；0 = 关闭；POST /admin/rebuild 后仍会 optimize）
DSH_FTS_OPTIMIZE_INTERVAL_SECONDS=86400
# 派生重建 executemany 批大小（默认 500）
DSH_DERIVE_BATCH_SIZE=500

# 是否启动后台派生循环线程：默认随「RETRIEVAL_ROUTES 含 vector 且 embedding
# 已配置」自动开启（否则写入后 embedding 永久 pending）；显式设 0 才关闭。
# 也可手动 POST /derive/tick。
DSH_DERIVE_LOOP_ENABLED=

# 派生 stub 是否直接视为成功（默认 1；置 0 用于验证失败计数路径）
DSH_DERIVE_STUB_SUCCESS=1

# ---- 检索层 v9（索引文本日期前缀 + 2026-11-11 真实 embedding 重测后）------
# 出厂默认向量单路（R@6=0.8729；bigram 0.4875）。等权 RRF 融合只有 0.6833，
# 显著低于向量单路，因此默认单路直出、不做 RRF 融合。
# 向量不可用（未配置/熔断/库内无向量/查询异常）时自动降级 bigram，并在
# degraded / vector-unavailable tag / NO_MATCH hint 标明；未配置 embedding 也能启动。
RETRIEVAL_ROUTES=vector
# 契约：strict-v1 默认 maxRankedResults=4；单条 1200 / 总 4800 字符
FINAL_K=4
ITEM_MAX_CHARS=1200
TOTAL_MAX_CHARS=4800
# 路内取 top-K（默认 50）与 RRF 常数 k（默认 60；仅显式多路时用到）
ROUTE_TOP_K=50
RRF_K=60
# 会话展开默认关（开启时只占 FINAL_K 名额内）
EXPAND_ENABLED=0
EXPAND_WINDOW=1
EXPAND_MAX_ITEMS=4
# 最佳名次弱命中阈值（默认 3）
WEAK_BEST_RANK=3
# 运行时质量自动降级：默认 0 = 不做（设计 §12）；仅离线评测复现时显式打开
RETRIEVAL_AUTO_DEGRADE=0
# R1 向量（启用 vector 路线时填 BASE_URL / MODEL；API_KEY 视服务而定）
EMBEDDING_BACKEND=openai-compat
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=auto
# 是否让 httpx 读取本机代理环境变量（NO_PROXY/HTTP_PROXY）。默认 0 = 直连
# embedding 端点：本机畸形 NO_PROXY（如 [::1]）会让 httpx 在构造 client 时崩，
# 且密钥请求不应经过用户代理。确需走代理才设 1。
EMBEDDING_TRUST_ENV=0
EMBEDDING_TIMEOUT_SECONDS=3
EMBEDDING_MAX_SPEND_USD=0.50

# ---- 生成侧（可选；shim 自身不调用，供评测/生成脚本复用）------------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_MAX_TOKENS=3000

# admin 端点：空则只接受回环；非空则要求 X-Admin-Token / Bearer
ADMIN_TOKEN=
# 金丝雀（v8 §9.12）
CANARY_ENABLED=1
CANARY_SIZE=20
CANARY_ALERT_RATE=0.20

# ---- 对接层（docs/06 v3）----------------------------------------------------
# provider discover 的固定空间标识：GET /spaces 返回它，适配器把它写进空间 connection，
# remember 的 session_id 也取这个值（两台机器天然一致，不靠人工约定）
FACTLAYER_SPACE_ID=factlayer-default
# /health 后台快照刷新间隔（秒）。请求路径只读快照、绝不跑聚合查询（O(1)）
HEALTH_REFRESH_SECONDS=5
